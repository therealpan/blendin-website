{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "https://blendin.app/", "permanent": true },
    { "source": "/:doc(privacy|cookie|terms).html", "destination": "https://blendin.app/:doc.html", "permanent": true },
    { "source": "/:path*", "destination": "https://blendin.app/", "permanent": true }
  ]
}
